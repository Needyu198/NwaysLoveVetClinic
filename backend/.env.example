PORT=5050
HOST=0.0.0.0
DB_HOST=localhost
DB_PORT=5432
DB_NAME=NwayLoveVetClinicSever
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_SCHEMA=public
DB_CONNECTION_TIMEOUT_MS=5000
REPORTING_URL=http://127.0.0.1:5060
CLINIC_TIME_ZONE=Asia/Bangkok
# Required for real phone push notifications. Paste the Firebase service
# account JSON as a single-line environment variable in production.
FIREBASE_SERVICE_ACCOUNT=
# Email delivery for Forgot Password. Create a Resend API key and use a
# verified sender address/domain. Never put this key in the Flutter app.
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Nway Love Vet Clinic <no-reply@example.com>
# Shared only with the trusted MMQR settlement adapter. It signs the UTF-8
# string "reference|amount|providerTransactionId|confirmed" using HMAC-SHA256.
# Never expose this secret in Flutter or the web portal.
MMQR_SETTLEMENT_SECRET=
# Public HTTPS origin used in receipt verification and PDF links.
PUBLIC_BASE_URL=http://127.0.0.1:5050
MMQR_MERCHANT_ID=
MMQR_MERCHANT_NAME=Nway Love Vet Clinic
MMQR_PROVIDER_QR_ENDPOINT=
MMQR_PROVIDER_API_KEY=
CLINIC_PHONE=
CLINIC_ADDRESS=
# The reporting service also accepts the backend's DATABASE_URL when present.

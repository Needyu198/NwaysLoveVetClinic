# Copy to .env and adjust before running `docker compose up`.
DB_NAME=NwayLoveVetClinicSever
DB_USER=postgres
DB_PASSWORD=change-me

# Public URL the staff web app should call the backend at (baked in at build).
STAFF_API_BASE_URL=http://localhost:5050

# Optional: paste the Firebase service-account JSON (single line) to enable FCM.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}
